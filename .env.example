# Entorno
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-only-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost

# Base de datos
POSTGRES_DB=betesda
POSTGRES_USER=betesda
POSTGRES_PASSWORD=betesda-local-only
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://betesda:betesda-local-only@db:5432/betesda

# Aplicacion
APP_PORT=8000
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_USE_X_FORWARDED_HOST=false
# Ruta de la administración técnica (solo superusuario). En producción usa una propia.
DJANGO_ADMIN_URL=admin/

# Correo para avisos de mensajes nuevos. Sin EMAIL_URL los correos salen en la consola.
# Ejemplo: EMAIL_URL=smtp+tls://usuario:clave@smtp.gmail.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Betesda Rosa de Sarón <no-responder@tudominio.org>
# Buzón de la iglesia que siempre recibe el aviso de peticiones y mensajes nuevos
CONTACT_NOTIFY_EMAILS=

# Seguridad del ingreso: fallos por usuario e IP, por IP y ventana en segundos
LOGIN_RATE_LIMIT_PER_USER=5
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_SECONDS=900
# Política de contenido: true solo avisa en la consola del navegador. Sin definir: avisa en
# desarrollo y bloquea en producción.
# DJANGO_CSP_REPORT_ONLY=

# Verificación en dos pasos obligatoria para el superusuario y Administración de la iglesia
TWO_FACTOR_ENFORCE=true
# Correo público para reportar vulnerabilidades (/.well-known/security.txt)
SECURITY_CONTACT_EMAIL=

# Formulario de contacto: segundos mínimos para enviarlo y máximo de mensajes por correo/hora
CONTACT_MIN_SECONDS=3
CONTACT_EMAIL_RATE_LIMIT_COUNT=3
CONTACT_EMAIL_RATE_LIMIT_SECONDS=3600
# Cloudflare Turnstile (opcional, gratis): "no soy un robot" sin acertijos. Claves en
# dash.cloudflare.com → Turnstile. Vacías = desactivado.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Horas sin actividad tras las que se cierra la sesión del panel
PANEL_SESSION_HOURS=8
# Correos extra para avisos de seguridad (separados por coma) y dirección pública del sitio
SECURITY_ALERT_EMAILS=
SITE_URL=http://localhost:8000
# Errores 500 por correo en producción (por defecto, SECURITY_ALERT_EMAILS)
ERROR_EMAILS=
# Minutos tras los que exportar mensajes o cambiar cuentas pide la contraseña otra vez
RECENT_AUTH_MINUTES=10

# Días que se guardan los mensajes cerrados, los no deseados y la IP de cada envío
MESSAGE_RETENTION_DAYS=365
SPAM_RETENTION_DAYS=30
IP_RETENTION_DAYS=90

# Primer administrador (solo para el comando bootstrap_admin)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-me-before-use

# Produccion: configurar en el proveedor, nunca confirmar secretos en Git
CADDY_DOMAIN=localhost
SECURE_HSTS_SECONDS=0


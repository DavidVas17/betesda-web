{$CADDY_DOMAIN} {
  encode zstd gzip

  handle_path /static/* {
    root * /srv/static
    file_server
    header Cache-Control "public, max-age=31536000, immutable"
  }

  handle_path /media/* {
    root * /srv/media
    file_server
    header Cache-Control "public, max-age=86400"
    # Archivos subidos: nunca se ejecutan como página aunque alguien lograra subir uno.
    header Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox"
  }

  reverse_proxy web:8000

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    # Django envía su propia Permissions-Policy y Content-Security-Policy; aquí solo se
    # completan si faltan (por ejemplo en los archivos estáticos).
    ?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  }
}


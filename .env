# Entorno
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-only-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost

# Base de datos
POSTGRES_DB=betesda
POSTGRES_USER=betesda
POSTGRES_PASSWORD=betesda-local-only
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://betesda:betesda-local-only@db:5432/betesda

# Aplicacion
APP_PORT=8000
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_USE_X_FORWARDED_HOST=false

# Primer administrador (solo para el comando bootstrap_admin)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=matematica123

# Produccion: configurar en el proveedor, nunca confirmar secretos en Git
CADDY_DOMAIN=localhost
SECURE_HSTS_SECONDS=0

